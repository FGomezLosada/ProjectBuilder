<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>ProjectBuilderDockWidgetBase</class>
 <widget class="QDockWidget" name="ProjectBuilderDockWidgetBase">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>400</width>
    <height>760</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>ProjectBuilder</string>
  </property>
  <widget class="QWidget" name="dockWidgetContents">
   <layout class="QVBoxLayout" name="mainLayout">
    <property name="leftMargin"><number>4</number></property>
    <property name="topMargin"><number>4</number></property>
    <property name="rightMargin"><number>4</number></property>
    <property name="bottomMargin"><number>4</number></property>
    <item>
     <layout class="QHBoxLayout" name="configLayout">
      <item>
       <widget class="QLabel" name="configLabel"><property name="text"><string>Configuración</string></property></widget>
      </item>
      <item>
       <widget class="QComboBox" name="configCombo">
        <property name="sizePolicy"><sizepolicy hsizetype="Expanding" vsizetype="Fixed"><horstretch>1</horstretch><verstretch>0</verstretch></sizepolicy></property>
        <property name="toolTip"><string>Elige una configuración guardada para rellenar el panel de una vez</string></property>
       </widget>
      </item>
      <item>
       <widget class="QToolButton" name="saveConfigButton">
        <property name="toolTip"><string>Guardar lo que hay ahora en el panel como configuración (capas, servicios, zona, SRC y formato)</string></property>
       </widget>
      </item>
      <item>
       <widget class="QToolButton" name="deleteConfigButton">
        <property name="toolTip"><string>Borrar la configuración elegida</string></property>
       </widget>
      </item>
     </layout>
    </item>
    <item>
     <widget class="QScrollArea" name="scrollArea">
      <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
      <property name="widgetResizable"><bool>true</bool></property>
      <widget class="QWidget" name="scrollContents">
       <layout class="QVBoxLayout" name="sectionsLayout">
        <property name="leftMargin"><number>0</number></property>
        <property name="topMargin"><number>0</number></property>
        <property name="rightMargin"><number>0</number></property>
        <property name="bottomMargin"><number>0</number></property>
        <!-- ============================== 1 · CAPAS ============================== -->
        <item>
         <widget class="QgsCollapsibleGroupBox" name="groupLayers">
          <property name="title"><string>1 · Capas</string></property>
          <property name="saveCollapsedState"><bool>true</bool></property>
          <property name="sizePolicy">
           <sizepolicy hsizetype="Preferred" vsizetype="Expanding"><horstretch>0</horstretch><verstretch>1</verstretch></sizepolicy>
          </property>
          <layout class="QVBoxLayout" name="layersLayout">
           <item>
            <layout class="QHBoxLayout" name="folderButtonsLayout">
             <item>
              <widget class="QPushButton" name="addFolderButton">
               <property name="text"><string>Añadir carpeta…</string></property>
               <property name="toolTip"><string>Añade una carpeta de capas al árbol. Se pueden añadir varias.</string></property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="removeFolderButton">
               <property name="text"><string>Quitar carpeta</string></property>
               <property name="toolTip"><string>Haz clic en una carpeta del árbol (o en cualquier capa suya) y pulsa aquí</string></property>
              </widget>
             </item>
             <item>
              <spacer name="folderButtonsSpacer">
               <property name="orientation"><enum>Qt::Horizontal</enum></property>
               <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
              </spacer>
             </item>
            </layout>
           </item>
           <item>
            <widget class="QgsFilterLineEdit" name="filterBox">
             <property name="placeholderText"><string>Buscar capas o carpetas…</string></property>
            </widget>
           </item>
           <item>
            <widget class="QTreeWidget" name="treeWidget">
             <property name="minimumSize"><size><width>0</width><height>220</height></size></property>
             <property name="headerHidden"><bool>true</bool></property>
             <property name="verticalScrollMode"><enum>QAbstractItemView::ScrollPerPixel</enum></property>
             <column><property name="text"><string>Capas</string></property></column>
            </widget>
           </item>
           <item>
            <layout class="QHBoxLayout" name="outputFormatLayout">
             <item>
              <widget class="QLabel" name="outputFormatLabel">
               <property name="text"><string>Formato de salida</string></property>
              </widget>
             </item>
             <item>
              <widget class="QComboBox" name="outputFormat">
               <property name="sizePolicy">
                <sizepolicy hsizetype="Expanding" vsizetype="Fixed"><horstretch>1</horstretch><verstretch>0</verstretch></sizepolicy>
               </property>
              </widget>
             </item>
            </layout>
           </item>
          </layout>
         </widget>
        </item>
        <!-- ============================== 2 · SERVICIOS ============================== -->
        <item>
         <widget class="QgsCollapsibleGroupBox" name="addWMS">
          <property name="title"><string>2 · Servicios web (WMS, WMTS, WFS)</string></property>
          <property name="toolTip"><string>Marca la casilla para añadir servicios web al proyecto</string></property>
          <property name="checkable"><bool>true</bool></property>
          <property name="checked"><bool>false</bool></property>
          <property name="saveCollapsedState"><bool>true</bool></property>
          <layout class="QVBoxLayout" name="servicesLayout">
           <item>
            <layout class="QHBoxLayout" name="servicesButtonsLayout">
             <item>
              <widget class="QgsFilterLineEdit" name="servicesFilter">
               <property name="placeholderText"><string>Buscar servicios o capas…</string></property>
              </widget>
             </item>
             <item>
              <widget class="QToolButton" name="favoriteButton">
               <property name="text"><string>★</string></property>
               <property name="toolTip"><string>Añadir o quitar de Favoritos la capa en la que has hecho clic</string></property>
              </widget>
             </item>
             <item>
              <widget class="QToolButton" name="newConnectionButton">
               <property name="toolTip"><string>Nueva conexión WMS/WMTS o WFS (abre el diálogo de QGIS)</string></property>
              </widget>
             </item>
             <item>
              <widget class="QToolButton" name="refreshServicesButton">
               <property name="toolTip"><string>Volver a leer las conexiones de QGIS y el catálogo</string></property>
              </widget>
             </item>
            </layout>
           </item>
           <item>
            <widget class="QTreeWidget" name="servicesTree">
             <property name="minimumSize"><size><width>0</width><height>180</height></size></property>
             <property name="headerHidden"><bool>true</bool></property>
             <column><property name="text"><string>Servicios</string></property></column>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="favoritesDefault">
             <property name="text"><string>Marcar mis favoritos al empezar un proyecto</string></property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <!-- ============================== 3 · ZONA DE TRABAJO ============================== -->
        <item>
         <widget class="QgsCollapsibleGroupBox" name="groupZone">
          <property name="title"><string>3 · Zona de trabajo (recorte)</string></property>
          <property name="toolTip"><string>Marca la casilla para recortar todas las capas por una zona (un municipio, un rectángulo...)</string></property>
          <property name="checkable"><bool>true</bool></property>
          <property name="checked"><bool>false</bool></property>
          <property name="saveCollapsedState"><bool>true</bool></property>
          <layout class="QFormLayout" name="zoneLayout">
           <item row="0" column="0">
            <widget class="QLabel" name="zoneTypeLabel"><property name="text"><string>Zona</string></property></widget>
           </item>
           <item row="0" column="1">
            <layout class="QHBoxLayout" name="zoneTypeLayout">
             <item>
              <widget class="QRadioButton" name="zoneByLayer">
               <property name="text"><string>Capa</string></property>
               <property name="checked"><bool>true</bool></property>
               <property name="toolTip"><string>Los polígonos de una capa abierta en QGIS (p. ej. un término municipal)</string></property>
              </widget>
             </item>
             <item>
              <widget class="QRadioButton" name="zoneByExtent">
               <property name="text"><string>Rectángulo</string></property>
               <property name="toolTip"><string>La extensión del mapa, la de una capa o un rectángulo dibujado en el mapa</string></property>
              </widget>
             </item>
            </layout>
           </item>
           <item row="1" column="0">
            <widget class="QLabel" name="zoneLayerLabel"><property name="text"><string>Capa</string></property></widget>
           </item>
           <item row="1" column="1">
            <widget class="QgsMapLayerComboBox" name="zoneLayer">
             <property name="toolTip"><string>Capa de polígonos abierta en QGIS que marca la zona</string></property>
            </widget>
           </item>
           <item row="2" column="1">
            <widget class="QCheckBox" name="zoneSelected">
             <property name="text"><string>Solo los elementos seleccionados</string></property>
            </widget>
           </item>
           <item row="3" column="0">
            <widget class="QLabel" name="zoneExtentLabel"><property name="text"><string>Rectángulo</string></property></widget>
           </item>
           <item row="3" column="1">
            <widget class="QWidget" name="zoneExtentHolder">
             <layout class="QHBoxLayout" name="zoneExtentLayout">
              <property name="leftMargin"><number>0</number></property>
              <property name="topMargin"><number>0</number></property>
              <property name="rightMargin"><number>0</number></property>
              <property name="bottomMargin"><number>0</number></property>
             </layout>
            </widget>
           </item>
           <item row="4" column="0">
            <widget class="QLabel" name="zoneMarginLabel"><property name="text"><string>Margen</string></property></widget>
           </item>
           <item row="4" column="1">
            <widget class="QgsDoubleSpinBox" name="zoneMargin">
             <property name="toolTip"><string>Amplía la zona estos metros alrededor (0 = sin margen)</string></property>
             <property name="suffix"><string> m</string></property>
             <property name="decimals"><number>0</number></property>
             <property name="maximum"><double>100000</double></property>
             <property name="singleStep"><double>100</double></property>
            </widget>
           </item>
           <item row="5" column="0" colspan="2">
            <widget class="QCheckBox" name="zoneAddLayer">
             <property name="text"><string>Añadir la zona al proyecto como capa</string></property>
             <property name="checked"><bool>true</bool></property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <!-- ============================== 4 · PROYECTO ============================== -->
        <item>
         <widget class="QgsCollapsibleGroupBox" name="groupProject">
          <property name="title"><string>4 · Proyecto</string></property>
          <property name="saveCollapsedState"><bool>true</bool></property>
          <layout class="QFormLayout" name="projectLayout">
           <item row="0" column="0">
            <widget class="QLabel" name="nameLabel"><property name="text"><string>Nombre</string></property></widget>
           </item>
           <item row="0" column="1">
            <widget class="QLineEdit" name="nameProject">
             <property name="placeholderText"><string>p. ej. mi_proyecto</string></property>
            </widget>
           </item>
           <item row="1" column="0">
            <widget class="QLabel" name="folderLabel"><property name="text"><string>Carpeta</string></property></widget>
           </item>
           <item row="1" column="1">
            <layout class="QHBoxLayout" name="projectFolderLayout">
             <item>
              <widget class="QLineEdit" name="pathFolderProject">
               <property name="placeholderText"><string>Se crea si no existe</string></property>
              </widget>
             </item>
             <item>
              <widget class="QToolButton" name="selectFolderProject"><property name="text"><string>…</string></property></widget>
             </item>
            </layout>
           </item>
           <item row="2" column="0">
            <widget class="QLabel" name="crsLabel">
             <property name="text"><string>SRC</string></property>
             <property name="toolTip"><string>Sistema de Referencia de Coordenadas del proyecto</string></property>
            </widget>
           </item>
           <item row="2" column="1">
            <widget class="QgsProjectionSelectionWidget" name="selectProjection"/>
           </item>
           <item row="3" column="1">
            <widget class="QCheckBox" name="reprojectCheck">
             <property name="text"><string>Reproyectar todas las capas a este SRC</string></property>
             <property name="checked"><bool>true</bool></property>
             <property name="toolTip"><string>Marcado: cada capa se transforma al SRC del proyecto al copiarla (recomendado).
Desmarcado: cada capa se copia en su SRC original; el proyecto usa este SRC y QGIS las muestra juntas reproyectando al vuelo.</string></property>
            </widget>
           </item>
           <item row="4" column="0">
            <widget class="QLabel" name="layoutsLabel">
             <property name="text"><string>Composiciones</string></property>
             <property name="toolTip"><string>Composiciones de impresión (con su cajetín) que se copian al proyecto nuevo</string></property>
            </widget>
           </item>
           <item row="4" column="1">
            <layout class="QVBoxLayout" name="layoutsLayout">
             <item>
              <widget class="QTreeWidget" name="layoutsTree">
               <property name="headerHidden"><bool>true</bool></property>
               <property name="maximumSize"><size><width>16777215</width><height>130</height></size></property>
               <property name="toolTip"><string>Marca las composiciones que quieres en el proyecto nuevo.
Sus mapas se centran en la zona de trabajo (o en todas las capas) y usan el SRC del proyecto.
En los textos del cajetín puedes usar [% @project_title %] (nombre del proyecto) o [% format_date(now(), 'dd/MM/yyyy') %].</string></property>
               <column><property name="text"><string>Composiciones</string></property></column>
              </widget>
             </item>
             <item>
              <layout class="QHBoxLayout" name="layoutsButtonsLayout">
               <item>
                <widget class="QToolButton" name="addLayoutButton">
                 <property name="text"><string>Añadir plantilla .qpt…</string></property>
                </widget>
               </item>
               <item>
                <widget class="QToolButton" name="removeLayoutButton">
                 <property name="toolTip"><string>Quitar de la lista la plantilla .qpt en la que has hecho clic (el fichero no se borra)</string></property>
                </widget>
               </item>
               <item>
                <spacer name="layoutsSpacer">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>10</width><height>10</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
            </layout>
           </item>
          </layout>
         </widget>
        </item>
       </layout>
      </widget>
     </widget>
    </item>
    <!-- ============================== RESUMEN Y BOTONES ============================== -->
    <item>
     <widget class="QLabel" name="summaryLabel">
      <property name="wordWrap"><bool>true</bool></property>
      <property name="text"><string/></property>
     </widget>
    </item>
    <item>
     <layout class="QHBoxLayout" name="bottomButtonsLayout">
      <item>
       <widget class="QPushButton" name="statsButton">
        <property name="text"><string>Informe de capas…</string></property>
        <property name="toolTip"><string>Muestra al instante lo que llevará el proyecto: cada capa con su tipo, elementos, superficie o longitud, SRC y tamaño (ya recortada a la zona de trabajo). Se puede guardar en PDF, HTML o CSV.</string></property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="resetButton">
        <property name="text"><string>Limpiar</string></property>
        <property name="toolTip"><string>Deja el formulario vacío para preparar otro proyecto (no borra ningún fichero)</string></property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="createProject">
        <property name="sizePolicy">
         <sizepolicy hsizetype="Expanding" vsizetype="Fixed"><horstretch>1</horstretch><verstretch>0</verstretch></sizepolicy>
        </property>
        <property name="text"><string>Crear proyecto</string></property>
       </widget>
      </item>
     </layout>
    </item>
   </layout>
  </widget>
 </widget>
